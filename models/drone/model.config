<?xml version="1.0"?>
<model>
  <name>Swarm Quadrotor</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    One lightweight quadrotor for Phase 1 ROS 2 communication validation.
    Velocity control with gravity disabled; rotor aerodynamics are not simulated.
    All geometry is local SDFormat primitives.
  </description>
</model>
